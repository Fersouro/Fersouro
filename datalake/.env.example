# Copie para .env e preencha. O arquivo .env NAO vai para o git.

# ---- Fonte Oracle (ERP) ----
# DSN pode ser:
#   host:porta/service_name        -> ex.: 192.168.0.10:1521/ORCLPDB1
#   nome do tnsnames.ora           -> ex.: ERPPRD  (exige thick_mode: true)
ORACLE_ERP_DSN=192.168.0.10:1521/ORCLPDB1
ORACLE_ERP_USER=datalake_ro
ORACLE_ERP_PASSWORD=troque-me

# ---- Fonte CCM (mesmo servidor, outro schema) ----
# Variaveis proprias mesmo apontando para o mesmo banco: se um dia o CCM ganhar
# um usuario somente leitura so dele, muda aqui e nada mais precisa mudar.
ORACLE_CCM_DSN=192.168.0.10:1521/ORCLPDB1
ORACLE_CCM_USER=datalake_ro
ORACLE_CCM_PASSWORD=troque-me

# Somente se usar thick mode (tnsnames, wallet, charset legado)
# ORACLE_CLIENT_LIB_DIR=C:\oracle\instantclient_21_13

# ---- Opcional: sobrescreve o diretorio raiz do lake ----
# DATALAKE_ROOT=D:\datalake\data

# ---- RPA do Portal Rede VW (RPA-PORTAL-VW.bat) ----
# Login no https://www.portalredevw.com.br/ e o usuario a escolher depois dele.
# Ponha estes valores em C:\datalake\.env (nao no git).
RPA_PORTALVW_USUARIO=
RPA_PORTALVW_SENHA=
RPA_PORTALVW_ALVO=

# ---- RPA SAGA2 - VH47 (SAGA-VH47.bat) ----
# DN da concessionaria na lista do portal (varios: separados por virgula)
SAGA_DN=
# Planilha JA EXISTENTE que recebe O.S. (SG) e Valor total da SG
SAGA_PLANILHA=C:\datalake\planilhas\garantia.xlsx
# Login: manual no navegador (fica guardado). Automatico: RPA_PORTALVW_USUARIO/SENHA acima.
